{
  "name": "dsh-plugin-scroll-memory",
  "version": "2.1.5",
  "description": "让 DeepSeek Harness 自带的「设置 → 插件」列表记住滚动位置：在「已安装」和「发现」市场之间自由切换，或从插件详情/配置页返回时，各自回到原来浏览的位置，两边独立运行互不干扰。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "scroll",
    "settings",
    "plugins"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  }
}
